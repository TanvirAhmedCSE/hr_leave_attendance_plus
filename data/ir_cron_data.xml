<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="ir_cron_generate_monthly_sheets" model="ir.cron">
        <field name="name">Attendance Sheet: generate last month's sheet</field>
        <field name="model_id" ref="model_hr_attendance_sheet"/>
        <field name="state">code</field>
        <field name="code">model._cron_generate_monthly_sheets()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active" eval="True"/>
    </record>

    <record id="ir_cron_remind_pending_leaves" model="ir.cron">
        <field name="name">Time Off: remind pending approvals</field>
        <field name="model_id" ref="hr_holidays.model_hr_leave"/>
        <field name="state">code</field>
        <field name="code">model._cron_remind_pending_approvals()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active" eval="True"/>
    </record>

</odoo>
