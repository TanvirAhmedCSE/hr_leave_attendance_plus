<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="hr_attendance_rule_view_list" model="ir.ui.view">
        <field name="name">hr.attendance.rule.list</field>
        <field name="model">hr.attendance.rule</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="level2_days"/>
                <field name="level3_days"/>
                <field name="grace_minutes"/>
            </list>
        </field>
    </record>

    <record id="hr_attendance_rule_view_form" model="ir.ui.view">
        <field name="name">hr.attendance.rule.form</field>
        <field name="model">hr.attendance.rule</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="company_id" groups="base.group_multi_company"/>
                    </group>
                    <group>
                        <group string="Time Off Approval Chain">
                            <field name="level2_days"/>
                            <field name="level3_days"/>
                            <field name="enforce_distinct_approvers"/>
                            <field name="reminder_days"/>
                        </group>
                        <group string="Late Policy">
                            <field name="grace_minutes"/>
                            <field name="late_count_threshold"/>
                            <field name="late_cut_days"/>
                        </group>
                    </group>
                    <group string="Salary Base">
                        <group>
                            <field name="days_in_month"/>
                            <field name="hours_per_day"/>
                        </group>
                        <group>
                            <field name="overtime_rate"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="hr_attendance_rule_action" model="ir.actions.act_window">
        <field name="name">Leave &amp; Attendance Rules</field>
        <field name="res_model">hr.attendance.rule</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
