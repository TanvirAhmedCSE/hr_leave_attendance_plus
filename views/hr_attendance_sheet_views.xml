<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="hr_attendance_sheet_view_list" model="ir.ui.view">
        <field name="name">hr.attendance.sheet.list</field>
        <field name="model">hr.attendance.sheet</field>
        <field name="arch" type="xml">
            <list decoration-muted="state == 'cancelled'" decoration-success="state == 'done'">
                <field name="name"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="total_deduction_amount" sum="Total"/>
                <field name="total_ot_amount" sum="Total"/>
                <field name="total_net_adjustment" sum="Total"/>
                <field name="state" widget="badge"
                       decoration-info="state == 'draft'"
                       decoration-warning="state == 'confirmed'"
                       decoration-success="state == 'done'"/>
            </list>
        </field>
    </record>

    <record id="hr_attendance_sheet_view_form" model="ir.ui.view">
        <field name="name">hr.attendance.sheet.form</field>
        <field name="model">hr.attendance.sheet</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_generate_lines" type="object" string="Generate Lines"
                            class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_refresh_figures" type="object" string="Refresh Figures"
                            invisible="state != 'draft' or not line_ids"
                            confirm="Manual changes made on the lines (except the monthly gross) will be overwritten. Continue?"/>
                    <button name="action_confirm" type="object" string="Confirm"
                            class="btn-primary" invisible="state != 'draft' or not line_ids"/>
                    <button name="action_done" type="object" string="Mark as Done"
                            class="btn-primary" invisible="state != 'confirmed'"
                            groups="hr.group_hr_manager"/>
                    <button name="action_set_draft" type="object" string="Reset to Draft"
                            invisible="state not in ['confirmed', 'cancelled']"/>
                    <button name="action_cancel" type="object" string="Cancel"
                            invisible="state in ['done', 'cancelled']"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,confirmed,done"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="month" readonly="state != 'draft'"/>
                            <field name="year" readonly="state != 'draft'"/>
                            <field name="company_id" groups="base.group_multi_company"
                                   readonly="state != 'draft'"/>
                        </group>
                        <group>
                            <field name="date_from"/>
                            <field name="date_to"/>
                            <field name="department_ids" widget="many2many_tags"
                                   readonly="state != 'draft'"/>
                        </group>
                    </group>
                    <field name="line_ids" readonly="state != 'draft'">
                        <list editable="bottom" decoration-danger="absent_days &gt; 0">
                            <field name="employee_id"/>
                            <field name="department_id" optional="hide"/>
                            <field name="scheduled_days" optional="show"/>
                            <field name="present_days"/>
                            <field name="leave_days" optional="show"/>
                            <field name="unpaid_leave_days" optional="show"/>
                            <field name="absent_days"/>
                            <field name="late_count"/>
                            <field name="late_minutes" optional="hide"/>
                            <field name="late_deduction_days" optional="show"/>
                            <field name="ot_hours"/>
                            <field name="monthly_gross"/>
                            <field name="total_deduction_days" optional="show"/>
                            <field name="deduction_amount" sum="Total"/>
                            <field name="ot_amount" sum="Total"/>
                            <field name="net_adjustment" sum="Total"/>
                            <field name="note" optional="show"/>
                        </list>
                    </field>
                    <group class="oe_subtotal_footer">
                        <field name="total_deduction_amount"/>
                        <field name="total_ot_amount"/>
                        <field name="total_net_adjustment" class="oe_subtotal_footer_separator"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="hr_attendance_sheet_view_search" model="ir.ui.view">
        <field name="name">hr.attendance.sheet.search</field>
        <field name="model">hr.attendance.sheet</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <filter string="Draft" name="draft" domain="[('state', '=', 'draft')]"/>
                <filter string="Confirmed" name="confirmed" domain="[('state', '=', 'confirmed')]"/>
                <filter string="Done" name="done" domain="[('state', '=', 'done')]"/>
                <group>
                    <filter string="Year" name="group_year" context="{'group_by': 'year'}"/>
                    <filter string="Status" name="group_state" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="hr_attendance_sheet_action" model="ir.actions.act_window">
        <field name="name">Monthly Attendance Sheets</field>
        <field name="res_model">hr.attendance.sheet</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create your first monthly attendance sheet</p>
            <p>The sheet is also generated automatically during the first days of each month.</p>
        </field>
    </record>

</odoo>
