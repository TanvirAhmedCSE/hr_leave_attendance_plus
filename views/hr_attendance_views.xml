<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="hr_attendance_view_tree_plus" model="ir.ui.view">
        <field name="name">hr.attendance.list.plus</field>
        <field name="model">hr.attendance</field>
        <field name="inherit_id" ref="hr_attendance.view_attendance_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='worked_hours']" position="after">
                <field name="late_minutes" string="Late (min)" optional="show"
                       decoration-danger="late_minutes &gt; 0"/>
            </xpath>
        </field>
    </record>

    <record id="hr_attendance_action_late" model="ir.actions.act_window">
        <field name="name">Late Arrivals</field>
        <field name="res_model">hr.attendance</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('is_late', '=', True)]</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No late arrival</p>
            <p>An attendance is late when the first check-in of the day is after the scheduled start plus the grace period.</p>
        </field>
    </record>

</odoo>
