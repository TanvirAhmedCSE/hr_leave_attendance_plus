<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="hr_employee_view_form_plus" model="ir.ui.view">
        <field name="name">hr.employee.form.plus</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_late_attendance" type="object"
                        class="oe_stat_button" icon="fa-clock-o"
                        groups="hr.group_hr_user">
                    <field name="late_count_month" widget="statinfo" string="Late (this month)"/>
                </button>
            </xpath>
        </field>
    </record>

</odoo>
